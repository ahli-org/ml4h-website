---
import BaseLayout from '../layouts/BaseLayout.astro';
import SponsorTiers from '../components/SponsorTiers.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { SITE, url } from '../lib/site';

const facts = [
  { k: 'Dates', v: SITE.dates },
  { k: 'Location', v: SITE.location },
  { k: 'Format', v: 'In-person symposium' },
  { k: 'Submission Deadline', v: SITE.deadline },
  { k: 'Paper Decisions', v: SITE.decisions },
  { k: 'Contact', v: SITE.email },
];
---
<BaseLayout title="Home">
  <header class="hero hero--home">
    <div class="hero-inner">
      <span class="date-badge">{SITE.dates} · {SITE.location}</span>
      <h1>{SITE.name}</h1>
      <p class="hero-lead">
        The ML4H Symposium (Machine Learning for Health) is a leading venue for
        research at the intersection of machine learning and health — bringing
        together researchers, clinicians, and practitioners to advance the science
        and practice of ML for health.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href={SITE.register} target="_blank" rel="noopener noreferrer">Register</a>
        <a class="btn btn-ghost" href="http://eepurl.com/jsz3P2" target="_blank" rel="noopener noreferrer">Sign Up for Emails</a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">At a glance</p>
      <h2>ML4H 2026</h2>
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact"><dt>{f.k}</dt><dd>{f.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--cta">
    <div class="wrap">
      <div class="cta">
        <h2>Paper Decisions are Available</h2>
        <p>
          Paper decisions for both the Proceedings and Findings tracks have been released.
          Congratulations to all accepted authors — registration for ML4H 2026 is now open.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={SITE.register} target="_blank" rel="noopener noreferrer">Register</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--gallery">
    <PhotoGallery />
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Sponsors</p>
      <h2>Our sponsors</h2>
      <p class="section-lead">
        ML4H 2026 is made possible by the generous support of our sponsors.
      </p>

      <SponsorTiers />

      <div class="btn-row">
        <a class="btn btn-outline" href={url('sponsors')}>Sponsorship information</a>
      </div>
    </div>
  </section>
</BaseLayout>
