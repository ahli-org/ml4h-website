---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, url } from '../lib/site';

const base = import.meta.env.BASE_URL;

const facts = [
  { k: 'Dates', v: SITE.dates },
  { k: 'Location', v: SITE.location },
  { k: 'Format', v: 'In-person symposium' },
  { k: 'Submission Deadline', v: SITE.deadline },
  { k: 'Decisions Released', v: SITE.decisions },
  { k: 'Contact', v: SITE.email },
];

const tiers = [
  {
    tier: 'diamond',
    label: 'Diamond',
    sponsors: [],
  },
  {
    tier: 'gold',
    label: 'Gold',
    sponsors: [],
  },
  {
    tier: 'silver',
    label: 'Silver',
    sponsors: [
      { name: 'ADIA Lab', url: 'https://www.adialab.ae/', logo: 'logos/adia.png' },
    ],
  },
];
---
<BaseLayout title="Home">
  <header class="hero hero--home">
    <div class="hero-inner">
      <span class="date-badge">{SITE.dates} · {SITE.location}</span>
      <h1>{SITE.name}</h1>
      <p class="hero-lead">
        The ML4H Symposium (Machine Learning for Health) is a leading venue for
        research at the intersection of machine learning and health — bringing
        together researchers, clinicians, and practitioners to advance the science
        and practice of ML for health.
      </p>
      <div class="btn-row">
        <span class="btn btn-primary btn-disabled" aria-disabled="true">Register (coming soon)</span>
        <a class="btn btn-ghost" href="http://eepurl.com/jsz3P2" target="_blank" rel="noopener noreferrer">Sign Up for Emails</a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">At a glance</p>
      <h2>ML4H 2026</h2>
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact"><dt>{f.k}</dt><dd>{f.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta">
        <h2>Reviewing is underway</h2>
        <p>
          Paper and demonstration submissions are now closed. Reviews are in progress: the author
          response period runs October 5&ndash;12, and decisions are released on {SITE.decisions}.
          Career Mentorship applications remain open until October 26.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={url('resources/reviewing-guidelines')}>Reviewing Guidelines</a>
          <a class="btn btn-ghost" href={url('submit/mentorship-programs')}>Career Mentorship</a>
          <a class="btn btn-outline" href={url('submit/call-for-papers')}>Call for Participation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Sponsors</p>
      <h2>Our sponsors</h2>
      <p class="section-lead">
        ML4H 2026 is made possible by the generous support of our sponsors.
      </p>

      {tiers.map((t) => (
        <div class={`sponsor-tier sponsor-tier--${t.tier}`}>
          <div class="sponsor-tier-badge">{t.label}</div>
          {t.sponsors.length > 0 ? (
            <div class="sponsor-grid">
              {t.sponsors.map((s: any) => (
                <article class="sponsor-card">
                  {s.logo ? (
                    <a href={s.url} target="_blank" rel="noopener noreferrer">
                      <img class="sponsor-logo" src={`${base}${s.logo}`} alt={s.name} width="924" height="190" loading="lazy" />
                    </a>
                  ) : (
                    <span class="sponsor-name">{s.name}</span>
                  )}
                </article>
              ))}
            </div>
          ) : (
            <p class="sponsor-placeholder">Sponsor announcements coming soon.</p>
          )}
        </div>
      ))}

      <div class="btn-row">
        <a class="btn btn-outline" href={url('sponsors')}>Sponsorship information</a>
      </div>
    </div>
  </section>
</BaseLayout>
